<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">
    <TextView android:id="@+id/tvGuestName" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"
        android:text="QR Code"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Show this screen to security at the gate" android:textColor="@color/text_secondary"
        android:textSize="13sp" android:layout_marginTop="4dp" android:gravity="center"/>
    <ImageView android:id="@+id/ivQrCode" android:layout_width="220dp" android:layout_height="220dp"
        android:layout_marginTop="16dp" android:contentDescription="Visitor QR code"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDone"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:text="Done"/>
</LinearLayout>
