<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/tvTodayCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Today: 0 visitors" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:padding="16dp" android:paddingBottom="4dp"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvVisitors"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:paddingBottom="80dp" android:clipToPadding="false"/>
        <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚪" android:textSize="48sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No visitors logged"
                android:textColor="@color/text_secondary" android:textSize="16sp" android:layout_marginTop="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScan" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_margin="16dp" android:layout_marginBottom="88dp"
        app:srcCompat="@drawable/ic_qr_scan" android:contentDescription="Scan QR" android:backgroundTint="@color/primary"
        android:visibility="gone"/>
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_margin="16dp"
        android:text="Log Visitor" app:icon="@drawable/ic_add" android:backgroundTint="@color/secondary"
        android:visibility="gone"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
