rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function mySocietyId() {
      return myProfile().societyId;
    }

    function myRole() {
      return myProfile().role;
    }

    function inSociety(societyId) {
      return signedIn() && mySocietyId() == societyId;
    }

    function hasRole(roles) {
      return signedIn() && myRole() in roles;
    }

    // ── users ──────────────────────────────────────────────────────────
    // Profiles are only ever created by Cloud Functions (Admin SDK, during
    // signup / invite redemption) — never directly by the client. Reads
    // and list queries are scoped per-document to the caller's own society
    // so cross-tenant enumeration isn't possible even via an unfiltered
    // query. A user may update their own profile but never their own
    // role/societyId (that would be self-escalation); role/societyId
    // changes go through Cloud Functions. An admin may remove a member of
    // their own society (but never themselves) — used by the member
    // directory's "remove member" action.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || resource.data.societyId == mySocietyId());
      allow list: if signedIn() && resource.data.societyId == mySocietyId();
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.societyId == resource.data.societyId;
      allow delete: if signedIn() && hasRole(['ADMIN'])
                    && resource.data.societyId == mySocietyId()
                    && uid != request.auth.uid;
    }

    // ── societies ──────────────────────────────────────────────────────
    // Members of a society can read its doc. Only the secretary can write
    // most fields (e.g. regenerating invite code, setting UPI ID); the
    // subscription* fields and secretaryUid are Cloud-Function-only
    // (verified Play Billing / payment webhooks flip those), enforced by
    // requiring those fields to stay unchanged on client writes.
    match /societies/{societyId} {
      allow get: if inSociety(societyId);
      allow list: if false; // discovery happens via Cloud Function (invite code redemption), never a client list query
      allow create: if false; // via Cloud Function only
      allow update: if inSociety(societyId) && hasRole(['ADMIN'])
                    && request.resource.data.subscriptionActive == resource.data.subscriptionActive
                    && request.resource.data.subscriptionPlan == resource.data.subscriptionPlan
                    && request.resource.data.subscriptionExpiresAt == resource.data.subscriptionExpiresAt
                    && request.resource.data.secretaryUid == resource.data.secretaryUid;
      allow delete: if false;

      // ── notices ──────────────────────────────────────────────────────
      match /notices/{noticeId} {
        allow read: if inSociety(societyId);
        allow create, update, delete: if inSociety(societyId) && hasRole(['ADMIN', 'COMMITTEE']);
      }

      // ── complaints ───────────────────────────────────────────────────
      match /complaints/{complaintId} {
        allow read: if inSociety(societyId);
        allow create: if inSociety(societyId) && request.resource.data.raisedByUid == request.auth.uid;
        allow update, delete: if inSociety(societyId) && hasRole(['ADMIN', 'COMMITTEE']);
      }

      // ── maintenanceBills ─────────────────────────────────────────────
      // Residents may self-report a payment (attach a UTR reference) but
      // can never flip isPaid or alter the billed amount/dates themselves
      // — only ADMIN/TREASURER (after manually confirming the UPI payment)
      // can mark a bill paid.
      match /maintenanceBills/{billId} {
        allow read: if inSociety(societyId);
        allow create, delete: if inSociety(societyId) && hasRole(['ADMIN', 'TREASURER']);
        allow update: if inSociety(societyId) && (
          hasRole(['ADMIN', 'TREASURER']) ||
          (resource.data.residentUid == request.auth.uid
            && request.resource.data.isPaid == resource.data.isPaid
            && request.resource.data.amount == resource.data.amount
            && request.resource.data.dueDate == resource.data.dueDate
            && request.resource.data.flatNo == resource.data.flatNo
            && request.resource.data.residentUid == resource.data.residentUid)
        );
      }

      // ── visitors ─────────────────────────────────────────────────────
      // Security/Admin log walk-in entries and check guests out. A
      // resident/committee member may approve or deny a visitor for their
      // own flat, and may also self-create a pre-approved QR invite for
      // their own flat (status locked to APPROVED, checkIn unset until the
      // QR is scanned at the gate) — they can't pre-approve on anyone
      // else's behalf.
      match /visitors/{visitorId} {
        allow read: if inSociety(societyId);
        allow create: if inSociety(societyId) && (
          hasRole(['ADMIN', 'SECURITY']) ||
          (hasRole(['RESIDENT', 'COMMITTEE']) &&
            request.resource.data.visitingFlat == myProfile().flatNo &&
            request.resource.data.preApproved == true &&
            request.resource.data.status == 'APPROVED' &&
            request.resource.data.checkIn == null)
        );
        allow update: if inSociety(societyId) && (
          hasRole(['ADMIN', 'SECURITY']) ||
          (hasRole(['RESIDENT', 'COMMITTEE']) && resource.data.visitingFlat == myProfile().flatNo)
        );
        allow delete: if false;
      }

      // ── emergencyContacts ────────────────────────────────────────────
      match /emergencyContacts/{contactId} {
        allow read: if inSociety(societyId);
        allow create, update, delete: if inSociety(societyId) && hasRole(['ADMIN']);
      }

      // ── recurringConfig ──────────────────────────────────────────────
      match /recurringConfig/{configId} {
        allow read: if inSociety(societyId);
        allow create, update: if inSociety(societyId) && hasRole(['ADMIN']);
        allow delete: if false;
      }

      // ── ledger ───────────────────────────────────────────────────────
      // Every member can read the books (financial transparency); only
      // the secretary/treasurer can record income or expense entries.
      match /ledger/{entryId} {
        allow read: if inSociety(societyId);
        allow create, update, delete: if inSociety(societyId) && hasRole(['ADMIN', 'TREASURER']);
      }

      // ── amenities (bookable facility catalog) ─────────────────────────
      // Only the secretary/committee curate which facilities exist.
      match /amenities/{amenityId} {
        allow read: if inSociety(societyId);
        allow create, update, delete: if inSociety(societyId) && hasRole(['ADMIN', 'COMMITTEE']);
      }

      // ── bookings ───────────────────────────────────────────────────────
      // Any member can request a booking for themselves. The secretary or
      // committee may approve/deny any request; a resident may cancel only
      // their own request, and only while it's still pending.
      match /bookings/{bookingId} {
        allow read: if inSociety(societyId);
        allow create: if inSociety(societyId) && request.resource.data.bookedByUid == request.auth.uid;
        allow update: if inSociety(societyId) &&
          (hasRole(['ADMIN', 'COMMITTEE']) ||
           (resource.data.bookedByUid == request.auth.uid && resource.data.status == 'PENDING'));
        allow delete: if false;
      }

      // ── assets (society infrastructure: lifts, pumps, generators, etc.) ──
      // Only the secretary/committee curate the asset catalog and its
      // AMC/warranty/vendor details.
      match /assets/{assetId} {
        allow read: if inSociety(societyId);
        allow create, update, delete: if inSociety(societyId) && hasRole(['ADMIN', 'COMMITTEE']);
      }

      // ── serviceRecords (maintenance/service history for an asset) ────
      match /serviceRecords/{recordId} {
        allow read: if inSociety(societyId);
        allow create, update, delete: if inSociety(societyId) && hasRole(['ADMIN', 'COMMITTEE']);
      }

      // ── staff (society staff directory: watchman, sweeper, etc.) ─────
      // Only the secretary/committee maintain the staff roster.
      match /staff/{staffId} {
        allow read: if inSociety(societyId);
        allow create, update, delete: if inSociety(societyId) && hasRole(['ADMIN', 'COMMITTEE']);
      }

      // ── events ───────────────────────────────────────────────────────
      match /events/{eventId} {
        allow read: if inSociety(societyId);
        allow create, update, delete: if inSociety(societyId) && hasRole(['ADMIN', 'COMMITTEE']);
      }

      // ── polls ────────────────────────────────────────────────────────
      // Every member can read & vote — one vote each, enforced by the
      // vote doc's ID equalling the voter's own uid (re-voting overwrites
      // their own doc, never anyone else's). Only the secretary/committee
      // create, close, or delete a poll; votes are rejected once closed.
      match /polls/{pollId} {
        allow read: if inSociety(societyId);
        allow create, update, delete: if inSociety(societyId) && hasRole(['ADMIN', 'COMMITTEE']);

        match /votes/{voterUid} {
          allow read: if inSociety(societyId);
          allow create, update: if inSociety(societyId) && request.auth.uid == voterUid
            && get(/databases/$(database)/documents/societies/$(societyId)/polls/$(pollId)).data.isClosed == false;
          allow delete: if false;
        }
      }

      // ── agm (Annual General Meeting) ──────────────────────────────────
      // Every member can read meeting details and RSVP for themselves —
      // one RSVP each, enforced by the RSVP doc's ID equalling the
      // member's own uid (re-RSVPing overwrites their own doc, never
      // anyone else's). Only the secretary/committee schedule a meeting,
      // edit its agenda/minutes/status, or delete it.
      match /agm/{agmId} {
        allow read: if inSociety(societyId);
        allow create, update, delete: if inSociety(societyId) && hasRole(['ADMIN', 'COMMITTEE']);

        match /rsvps/{memberUid} {
          allow read: if inSociety(societyId);
          allow create, update: if inSociety(societyId) && request.auth.uid == memberUid;
          allow delete: if false;
        }
      }

      // ── documents (shared document vault) ─────────────────────────────
      // Every member can read/list document metadata. Only the secretary/
      // committee upload, edit, or delete a document — Storage's own
      // per-society rule stays broad (any signed-in member, <10MB), so this
      // Firestore check is what actually keeps uploads restricted.
      match /documents/{docId} {
        allow read: if inSociety(societyId);
        allow create, update, delete: if inSociety(societyId) && hasRole(['ADMIN', 'COMMITTEE']);
      }
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
